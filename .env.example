# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/omniwall.sqlite
# Host port binding for Docker Compose. Use 3000 for direct demo, or 127.0.0.1:3000 behind a local reverse proxy.
OMNIWALL_PORT_BINDING=3000
# Keep false for direct/public :3000 access. Set true only behind a trusted reverse proxy that controls X-Forwarded-* headers.
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=1048576
PUBLIC_BASE_URL=
SCHEDULE_INTERVAL_SECONDS=900
RUN_SCHEDULED_ON_START=true
# Best-effort analytics batching to reduce D1 writes. Set sample rate to 1 for every request.
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=0.1
D1_FLUSH_INTERVAL_SECONDS=30
D1_MAX_BATCH_SIZE=50

# Required admin credentials
ADMIN_USERNAME=admin
# ADMIN_PASSWORD is also used as an encryption/signing root. Use a 32+ character random value and do not rotate it casually after production use.
ADMIN_PASSWORD=replace-with-a-random-32-character-or-longer-password

# Optional image providers; configure at least one of these for non-Bing sources
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional site branding
SITE_NAME=OmniWall
SITE_FAVICON=

# Optional /api/bg signing secret; recommended to use a separate random value. Falls back to ADMIN_PASSWORD if empty.
BG_TOKEN_SECRET=

# Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional external moderation / translation
OPENAI_API_KEY=
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
